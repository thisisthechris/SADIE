SECRET_KEY=your-secret-key-here-change-in-production
# DEBUG must be False in production; set to True only for local development
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgis://sadie:sadie_password@db:5432/sadie

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Upload API token (simple shared secret for upload endpoints)
UPLOAD_API_TOKEN=change-this-upload-token-in-production

# CORS – comma-separated origins allowed to POST to /api/upload/ from a browser
# Example: CORS_ALLOWED_ORIGINS=https://your-integration.example.com
CORS_ALLOWED_ORIGINS=

# Required when running behind a TLS-terminating reverse proxy (Traefik, NPM).
# Django 4.x uses this to validate CSRF tokens on HTTPS requests.
# Example: CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=

# Static / Media
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/mediafiles

# ── Production / Portainer-specific ───────────────────────────────────────────

# Database password used by the db service in docker-compose.prod.yml.
# Must match the password component in DATABASE_URL above.
DB_PASSWORD=change-this-db-password
# DB_NAME=sadie
# DB_USER=sadie

# Traefik: domain used for the router rule label (Option A in docker-compose.prod.yml)
# DOMAIN=yourdomain.com

# Direct port mapping: host port gunicorn is exposed on (Option B, default 8000)
# WEB_PORT=8000

# Test/staging stacks ONLY: when "true", the web container runs
# `python manage.py simulate_test_data` on every deploy, adding a cumulative
# batch of demo venues/events/interactions/postcodes (see
# organisations/management/commands/simulate_test_data.py). Never set this on
# a real production stack's .env — it will keep adding fake data.
# SEED_DEMO_DATA=true
